{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["vite/client", "node"]
  },
  "include": [
    "benchmarks/iris/**/*.ts",
    "src/types/**/*.d.ts",
    "backend/**/*.ts",
    "src/platform/**/*.ts",
    "src/platform/**/*.tsx"
  ],
  "exclude": ["node_modules", "dist", "dist-electron", "backend-dist", "electron"]
}

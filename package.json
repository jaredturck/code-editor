{
  "name": "code-editor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build:backend && npm run build:electron && concurrently -k -s first \"npm:dev:renderer\" \"npm:dev:electron:watch\" \"npm:dev:electron:start\"",
    "dev:renderer": "vite",
    "dev:electron:watch": "tsc -p electron/tsconfig.json --watch --preserveWatchOutput",
    "dev:electron:start": "wait-on tcp:5173 && electron .",
    "build:electron": "tsc -p electron/tsconfig.json",
    "typecheck": "tsc -b && tsc -p electron/tsconfig.json --noEmit && npm run typecheck:backend",
    "build": "npm run build:backend && npm run build:electron && tsc -b && vite build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint src electron vite.config.ts",
    "test": "npm run build:backend && npm run build:electron && vitest run && npm run test:iris",
    "test:iris": "vitest run --config vitest.iris.config.ts",
    "test:watch": "vitest",
    "test:electron-runtime": "electron scripts/check-electron-runtime.cjs",
    "verify:full": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run test:electron-runtime && npm run build",
    "preview": "vite preview",
    "postinstall": "electron-rebuild -f -w node-pty",
    "build:backend": "tsc -p tsconfig.backend.json",
    "typecheck:backend": "tsc -p tsconfig.backend.json --noEmit",
    "benchmark": "vite-node benchmarks/iris/run.ts",
    "benchmark:iris": "npm run benchmark"
  },
  "dependencies": {
    "@astral-sh/ruff-wasm-nodejs": "^0.15.20",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.4",
    "@lezer/highlight": "^1.2.3",
    "@tailwindcss/vite": "^4.3.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "eslint": "^10.6.0",
    "highlight.js": "^11.11.1",
    "html-validate": "^11.0.0",
    "jsonc-parser": "^3.3.1",
    "markdownlint": "^0.41.0",
    "node-pty": "^1.1.0",
    "pdfjs-dist": "^6.2.108",
    "postcss-less": "^6.0.0",
    "postcss-scss": "^4.0.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "stylelint": "^17.14.0",
    "tailwindcss": "^4.3.2",
    "typescript": "~6.0.2",
    "yaml": "^2.9.0",
    "@huggingface/transformers": "3.8.1",
    "@mozilla/readability": "^0.6.0",
    "duck-duck-scrape": "^2.2.7",
    "fflate": "^0.8.3",
    "fuse.js": "^7.5.0",
    "jsdom": "26.1.0",
    "saxes": "^6.0.0",
    "sharp": "0.34.5",
    "sqlite3": "^5.1.7",
    "yauzl": "^2.10.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.6",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.3",
    "electron": "31.7.7",
    "oxlint": "^1.69.0",
    "prettier": "3.9.4",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wait-on": "^9.0.10",
    "@types/yauzl": "^2.10.3",
    "vite-node": "^3.2.4"
  },
  "main": "dist-electron/main.cjs",
  "overrides": {
    "onnxruntime-node": "1.21.0"
  }
}
